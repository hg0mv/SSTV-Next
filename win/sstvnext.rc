#include <winuser.h>
1 ICON "sstvnext.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sstvnext.manifest"
1 VERSIONINFO
FILEVERSION 0,10,0,0
PRODUCTVERSION 0,10,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "SSTV Next - analog and digital SSTV"
      VALUE "ProductName", "SSTV Next"
      VALUE "FileVersion", "0.10"
      VALUE "ProductVersion", "0.10"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
